{
  "info": {
    "_postman_id": "a9b8c7d6-e5f4-4321-abcd-1234567890ab",
    "name": "E11 - Orders & Products API Suite",
    "description": "Colección completa de pruebas de API con encadenamiento de flujo y aserciones automatizadas de status, esquema y contenido para Newman / CI-CD",
