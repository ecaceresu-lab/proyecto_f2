    {
      "name": "12 - Crear Orden de Compra (Flujo de Negocio)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{createdProductId}}\",\n      \"quantity\": 2\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": ["{{baseUrl}}"],
          "path": ["api", "orders"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('21. Creación de orden responde 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('22. Se calculan totales y se almacena createdOrderId', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.data.id).to.be.a('string');",
              "    pm.expect(json.data.status).to.eql('PENDING');",
              "    pm.expect(json.data.subtotal).to.eql(159.98);",
              "    pm.collectionVariables.set('createdOrderId', json.data.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
