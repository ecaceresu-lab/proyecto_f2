    {
      "name": "08 - Filtrar Productos por Categoría",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products?category=Accesorios",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products"],
          "query": [{ "key": "category", "value": "Accesorios" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('14. Filtro por categoría responde 200 y todos coinciden', function () {",
              "    pm.response.to.have.status(200);",
              "    var json = pm.response.json();",
              "    json.data.forEach(function(item) {",
              "        pm.expect(item.category).to.eql('Accesorios');",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "09 - Crear Producto (Admin)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sku\": \"CAM-{{$timestamp}}\",\n  \"name\": \"Cámara Web 4K UltraHD\",\n  \"description\": \"Autofocus y microfono estereo\",\n  \"price\": 89.50,\n  \"stock\": 30,\n  \"category\": \"Video\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products"]
        }
      },
      "event": [
