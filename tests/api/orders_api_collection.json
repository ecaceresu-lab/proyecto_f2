      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Maria Lopez\",\n  \"email\": \"maria_{{$timestamp}}@test.com\",\n  \"password\": \"Segura123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "register"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('5. Registro de usuario retorna 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('6. Objeto usuario tiene id y rol customer', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.data.role).to.eql('customer');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
