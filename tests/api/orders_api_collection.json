          "listen": "test",
          "script": {
            "exec": [
              "pm.test('15. Creación de producto responde 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('16. Guardar createdProductId para pruebas encadenadas', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.data.id).to.be.a('string');",
              "    pm.collectionVariables.set('createdProductId', json.data.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
